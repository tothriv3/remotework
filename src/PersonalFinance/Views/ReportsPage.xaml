<UserControl x:Class="PersonalFinance.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Отчёты" Style="{StaticResource PageTitle}" />

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ComboBox x:Name="ReportBox" Width="300" Margin="0,0,12,4" DisplayMemberPath="Title"
                      SelectionChanged="ReportBox_SelectionChanged" />
            <TextBlock Text="с" VerticalAlignment="Center" Margin="0,0,4,4" />
            <DatePicker x:Name="FromBox" Width="125" Margin="0,0,6,4" />
            <TextBlock Text="по" VerticalAlignment="Center" Margin="0,0,4,4" />
            <DatePicker x:Name="ToBox" Width="125" Margin="0,0,12,4" />
            <Button Content="Сформировать" Style="{StaticResource PrimaryButton}" Margin="0,0,12,4" Click="Build_Click" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,0,4" />
        </WrapPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="True" ColumnWidth="*"
                  AutoGeneratingColumn="Grid_AutoGeneratingColumn" />
    </DockPanel>
</UserControl>
