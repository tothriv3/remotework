<UserControl x:Class="PersonalFinance.Views.GoalsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Финансовые цели" Style="{StaticResource PageTitle}" />

        <Border DockPanel.Dock="Right" Style="{StaticResource FormPanel}">
            <StackPanel>
                <TextBlock x:Name="FormTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="Название" />
                <TextBox x:Name="NameBox" MaxLength="100" />
                <TextBlock Text="Счёт для накоплений" />
                <ComboBox x:Name="AccountBox" DisplayMemberPath="Display" />
                <TextBlock Text="Целевая сумма" />
                <TextBox x:Name="TargetBox" />
                <TextBlock Text="Накоплено" />
                <TextBox x:Name="CurrentBox" />
                <TextBlock Text="Срок (необязательно)" />
                <DatePicker x:Name="DeadlineBox" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                    <Button Content="Отмена" Margin="0" Click="Reset_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить" Click="Reset_Click" />
            <Button Content="Удалить" Click="Delete_Click" />
        </StackPanel>

        <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Цель" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Счёт" Binding="{Binding Account.Display}" Width="*" />
                <DataGridTextColumn Header="Сумма" Binding="{Binding TargetAmount, StringFormat=N2}" Width="105" />
                <DataGridTextColumn Header="Накоплено" Binding="{Binding CurrentAmount, StringFormat=N2}" Width="105" />
                <DataGridTemplateColumn Header="Прогресс" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:N0} %}"
                                           HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Срок" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy}" Width="95" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
