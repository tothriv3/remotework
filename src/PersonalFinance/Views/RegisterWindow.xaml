<Window x:Class="PersonalFinance.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontSize="14" Background="{StaticResource BackBrush}">
    <StackPanel Margin="30,24">
        <TextBlock Text="Новый пользователь" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />

        <TextBlock Text="ФИО" />
        <TextBox x:Name="NameBox" MaxLength="150" />
        <TextBlock Text="Email" />
        <TextBox x:Name="EmailBox" MaxLength="255" />
        <TextBlock Text="Пароль (не менее 8 символов, буквы и цифры)" TextWrapping="Wrap" />
        <PasswordBox x:Name="PasswordBox" />
        <TextBlock Text="Повторите пароль" />
        <PasswordBox x:Name="RepeatBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="Register_Click" />
            <Button Content="Отмена" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
