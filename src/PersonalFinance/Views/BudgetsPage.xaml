<UserControl x:Class="PersonalFinance.Views.BudgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Бюджеты" Style="{StaticResource PageTitle}" />

        <Border DockPanel.Dock="Right" Style="{StaticResource FormPanel}">
            <StackPanel>
                <TextBlock x:Name="FormTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="Категория расходов" />
                <ComboBox x:Name="CategoryBox" DisplayMemberPath="Display" />
                <TextBlock Text="Лимит" />
                <TextBox x:Name="LimitBox" />
                <TextBlock Text="Период" />
                <ComboBox x:Name="PeriodBox" SelectionChanged="Period_Changed" />
                <TextBlock Text="Дата начала" />
                <DatePicker x:Name="StartBox" SelectedDateChanged="Period_Changed" />
                <TextBlock Text="Дата окончания" />
                <DatePicker x:Name="EndBox" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                    <Button Content="Отмена" Margin="0" Click="Reset_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="ActiveOnly" Content="Только действующие" VerticalAlignment="Center"
                      Margin="0,0,12,0" Click="Filter_Changed" />
            <Button Content="Добавить" Click="Reset_Click" />
            <Button Content="Удалить" Click="Delete_Click" />
        </StackPanel>

        <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExceeded}" Value="True">
                            <Setter Property="Foreground" Value="#C62828" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                <DataGridTextColumn Header="Период" Binding="{Binding Period}" Width="80" />
                <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="95" />
                <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="95" />
                <DataGridTextColumn Header="Лимит" Binding="{Binding LimitAmount, StringFormat=N2}" Width="100" />
                <DataGridTextColumn Header="Потрачено" Binding="{Binding Spent, StringFormat=N2}" Width="100" />
                <DataGridTemplateColumn Header="Исполнение" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <ProgressBar Value="{Binding PercentUsed, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{Binding PercentUsed, StringFormat={}{0:N0} %}"
                                           HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
