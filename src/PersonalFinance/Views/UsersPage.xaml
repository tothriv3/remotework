<UserControl x:Class="PersonalFinance.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Пользователи" Style="{StaticResource PageTitle}" />

        <Border DockPanel.Dock="Right" Style="{StaticResource FormPanel}">
            <StackPanel>
                <TextBlock x:Name="FormTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="ФИО" />
                <TextBox x:Name="NameBox" MaxLength="150" />
                <TextBlock Text="Email" />
                <TextBox x:Name="EmailBox" MaxLength="255" />
                <TextBlock Text="Роль" />
                <ComboBox x:Name="RoleBox" DisplayMemberPath="Name" />
                <TextBlock x:Name="PasswordLabel" TextWrapping="Wrap" />
                <PasswordBox x:Name="PasswordBox" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                    <Button Content="Отмена" Margin="0" Click="Reset_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="SearchBox" Width="220" Margin="0,0,12,0" TextChanged="Filter_Changed" />
            <Button Content="Добавить" Click="Reset_Click" />
            <Button Content="Удалить" Click="Delete_Click" />
        </StackPanel>

        <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="130" />
                <DataGridTextColumn Header="Регистрация" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
