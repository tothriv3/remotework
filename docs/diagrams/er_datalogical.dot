// Даталогическая модель (сгенерирована по описанию таблиц)
digraph DB {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=1.1, dpi=150, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=16];
  edge [color="#1E3A5F", penwidth=1.4, dir=both, arrowtail=crow, arrowhead=tee];
  roles [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>roles</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="name" align="left" bgcolor="white"> </td><td align="left">name</td><td port="name_out" align="left"><font color="#555555">nvarchar(50)</font></td></tr></table>>];
  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>users</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="role_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">role_id</td><td port="role_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="full_name" align="left" bgcolor="white"> </td><td align="left">full_name</td><td port="full_name_out" align="left"><font color="#555555">nvarchar(150)</font></td></tr><tr><td port="email" align="left" bgcolor="white"> </td><td align="left">email</td><td port="email_out" align="left"><font color="#555555">nvarchar(255)</font></td></tr><tr><td port="password_hash" align="left" bgcolor="white"> </td><td align="left">password_hash</td><td port="password_hash_out" align="left"><font color="#555555">nvarchar(255)</font></td></tr><tr><td port="created_at" align="left" bgcolor="white"> </td><td align="left">created_at</td><td port="created_at_out" align="left"><font color="#555555">datetime</font></td></tr></table>>];
  currencies [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>currencies</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="code" align="left" bgcolor="white"> </td><td align="left">code</td><td port="code_out" align="left"><font color="#555555">nchar(3)</font></td></tr><tr><td port="name" align="left" bgcolor="white"> </td><td align="left">name</td><td port="name_out" align="left"><font color="#555555">nvarchar(50)</font></td></tr></table>>];
  accounts [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>accounts</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="user_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">user_id</td><td port="user_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="currency_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">currency_id</td><td port="currency_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="name" align="left" bgcolor="white"> </td><td align="left">name</td><td port="name_out" align="left"><font color="#555555">nvarchar(100)</font></td></tr><tr><td port="balance" align="left" bgcolor="white"> </td><td align="left">balance</td><td port="balance_out" align="left"><font color="#555555">decimal(18,2)</font></td></tr></table>>];
  categories [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>categories</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="user_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">user_id</td><td port="user_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="name" align="left" bgcolor="white"> </td><td align="left">name</td><td port="name_out" align="left"><font color="#555555">nvarchar(100)</font></td></tr><tr><td port="type" align="left" bgcolor="white"> </td><td align="left">type</td><td port="type_out" align="left"><font color="#555555">nvarchar(10)</font></td></tr><tr><td port="icon" align="left" bgcolor="white"> </td><td align="left">icon</td><td port="icon_out" align="left"><font color="#555555">nvarchar(10)</font></td></tr></table>>];
  transactions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>transactions</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="account_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">account_id</td><td port="account_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="category_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">category_id</td><td port="category_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="amount" align="left" bgcolor="white"> </td><td align="left">amount</td><td port="amount_out" align="left"><font color="#555555">decimal(18,2)</font></td></tr><tr><td port="transaction_date" align="left" bgcolor="white"> </td><td align="left">transaction_date</td><td port="transaction_date_out" align="left"><font color="#555555">date</font></td></tr><tr><td port="comment" align="left" bgcolor="white"> </td><td align="left">comment</td><td port="comment_out" align="left"><font color="#555555">nvarchar(255)</font></td></tr></table>>];
  budgets [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>budgets</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="user_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">user_id</td><td port="user_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="category_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">category_id</td><td port="category_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="limit_amount" align="left" bgcolor="white"> </td><td align="left">limit_amount</td><td port="limit_amount_out" align="left"><font color="#555555">decimal(18,2)</font></td></tr><tr><td port="period" align="left" bgcolor="white"> </td><td align="left">period</td><td port="period_out" align="left"><font color="#555555">nvarchar(10)</font></td></tr><tr><td port="start_date" align="left" bgcolor="white"> </td><td align="left">start_date</td><td port="start_date_out" align="left"><font color="#555555">date</font></td></tr><tr><td port="end_date" align="left" bgcolor="white"> </td><td align="left">end_date</td><td port="end_date_out" align="left"><font color="#555555">date</font></td></tr></table>>];
  notifications [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>notifications</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="user_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">user_id</td><td port="user_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="budget_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">budget_id</td><td port="budget_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="message" align="left" bgcolor="white"> </td><td align="left">message</td><td port="message_out" align="left"><font color="#555555">nvarchar(255)</font></td></tr><tr><td port="is_read" align="left" bgcolor="white"> </td><td align="left">is_read</td><td port="is_read_out" align="left"><font color="#555555">bit</font></td></tr><tr><td port="created_at" align="left" bgcolor="white"> </td><td align="left">created_at</td><td port="created_at_out" align="left"><font color="#555555">datetime</font></td></tr></table>>];
  goals [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>goals</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="user_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">user_id</td><td port="user_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="account_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">account_id</td><td port="account_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="name" align="left" bgcolor="white"> </td><td align="left">name</td><td port="name_out" align="left"><font color="#555555">nvarchar(100)</font></td></tr><tr><td port="target_amount" align="left" bgcolor="white"> </td><td align="left">target_amount</td><td port="target_amount_out" align="left"><font color="#555555">decimal(18,2)</font></td></tr><tr><td port="current_amount" align="left" bgcolor="white"> </td><td align="left">current_amount</td><td port="current_amount_out" align="left"><font color="#555555">decimal(18,2)</font></td></tr><tr><td port="deadline" align="left" bgcolor="white"> </td><td align="left">deadline</td><td port="deadline_out" align="left"><font color="#555555">date</font></td></tr></table>>];
  recurring_payments [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#2563EB"><tr><td colspan="3" bgcolor="#2563EB"><font color="white"><b>recurring_payments</b></font></td></tr><tr><td port="id" align="left" bgcolor="#FFF7E6"><b>PK</b></td><td align="left">id</td><td port="id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="account_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">account_id</td><td port="account_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="category_id" align="left" bgcolor="#FFF7E6"><b>FK</b></td><td align="left">category_id</td><td port="category_id_out" align="left"><font color="#555555">int</font></td></tr><tr><td port="amount" align="left" bgcolor="white"> </td><td align="left">amount</td><td port="amount_out" align="left"><font color="#555555">decimal(18,2)</font></td></tr><tr><td port="frequency" align="left" bgcolor="white"> </td><td align="left">frequency</td><td port="frequency_out" align="left"><font color="#555555">nvarchar(20)</font></td></tr><tr><td port="next_payment_date" align="left" bgcolor="white"> </td><td align="left">next_payment_date</td><td port="next_payment_date_out" align="left"><font color="#555555">date</font></td></tr></table>>];
  users:role_id_out:e -> roles:id:w;
  accounts:user_id_out:e -> users:id:w;
  accounts:currency_id_out:e -> currencies:id:w;
  categories:user_id_out:e -> users:id:w;
  transactions:account_id_out:e -> accounts:id:w;
  transactions:category_id_out:e -> categories:id:w;
  budgets:user_id_out:e -> users:id:w;
  budgets:category_id_out:e -> categories:id:w;
  notifications:user_id_out:e -> users:id:w;
  notifications:budget_id_out:e -> budgets:id:w;
  goals:user_id_out:e -> users:id:w;
  goals:account_id_out:e -> accounts:id:w;
  recurring_payments:account_id_out:e -> accounts:id:w;
  recurring_payments:category_id_out:e -> categories:id:w;
}
