<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Server: имя экземпляра SQL Server. Для SQL Server Express обычно .\SQLEXPRESS -->
    <add name="FinanceDb"
         connectionString="Server=.\SQLEXPRESS;Database=PersonalFinanceDB;Trusted_Connection=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
